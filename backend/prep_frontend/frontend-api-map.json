{
  "POST /register": {
    "role": "public",
    "auth_required": false,
    "pagination": false,
    "notes": "role must exist in roles table; role=2 merchant (pending), role=3 customer (approved); returns access_token"
  },
  "POST /login": {
    "role": "public",
    "auth_required": false,
    "pagination": false,
    "notes": "returns access_token; 403 if banned"
  },
  "GET /me": {
    "role": "any-authenticated",
    "auth_required": true,
    "pagination": false,
    "notes": "returns user with role"
  },
  "PUT /profile": {
    "role": "any-authenticated",
    "auth_required": true,
    "pagination": false,
    "notes": "multipart/form-data for avatar; updates name/email"
  },
  "PUT /change-password": {
    "role": "any-authenticated",
    "auth_required": true,
    "pagination": false,
    "notes": "requires current_password + new_password + new_password_confirmation"
  },
  "POST /logout": {
    "role": "any-authenticated",
    "auth_required": true,
    "pagination": false,
    "notes": "revokes all tokens"
  },

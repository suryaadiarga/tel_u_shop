    "role": "customer",
    "auth_required": true,
    "pagination": false,
    "notes": "owner only"
  },
  "GET /my-reviews": {
    "role": "customer",
    "auth_required": true,
    "pagination": true,
    "notes": "includes product id+name"
  },
  "GET /loyalty/balance": {
    "role": "customer",

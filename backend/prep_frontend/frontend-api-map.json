    "role": "customer",
    "auth_required": true,
    "pagination": false,
    "notes": "ownership enforced"
  },
  "DELETE /cart/clear": {
    "role": "customer",
    "auth_required": true,
    "pagination": false,
    "notes": "clears cart"
  },
  "POST /checkout": {
    "role": "customer",
    "auth_required": true,
    "pagination": false,
    "notes": "payment_method wallet|cash; notes accepted but not stored"
  },
  "GET /wallet/balance": {
    "role": "customer",
    "auth_required": true,
    "pagination": false,
